# ── Database (required for login, projects, drafts) ──────────────────────
# Local default when using the bundled docker-compose database:
#   postgresql://omoka:omoka_local_dev_only@localhost:5432/omoka
DATABASE_URL=
# "local" (JSON files in .data/) or "database" (PostgreSQL). Default: local.
REPOSITORY_BACKEND=

# ── WordPress live content (Slice 1/3) ───────────────────────────────────
# Base URL of the WordPress REST API (e.g. https://staging.example.co.ke/wp-json)
# Leave unset in development to render from the local fixture instead.
WORDPRESS_API_URL=
# Optional numeric page ID of the Home page. When empty, fetch by slug "home".
HOME_PAGE_ID=
# Cache/revalidation window for WordPress-fetched content, in seconds (default 3600).
WORDPRESS_REVALIDATE_SECONDS=3600
# Shared secret for POST /api/revalidate (the "refresh content" webhook).
# Any long random string. Referenced in the operator guide.
REVALIDATE_SECRET=

# Set to "true" to allow the local fixture as a content fallback regardless
# of NODE_ENV (useful for hosted preview deployments). Never enable in
# production for live customer sites.
PREVIEW_MODE=

# ── Server-side AI content generation (Slice 7) ──────────────────────────
# SAFE DEFAULT: real AI generation is disabled unless AI_GENERATION_ENABLED
# is explicitly "true" AND AI_MODEL is set. Credentials live only in
# .env.local (never committed) and are used exclusively server-side.
AI_GENERATION_ENABLED=
AI_PROVIDER=openai-compatible
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=12000
AI_TIMEOUT_MS=60000
AI_MAX_INPUT_CHARS=50000
AI_MAX_RETRIES=2

# WordPress staging integration (Slice 10) - names only, set real values in .env.local
WORDPRESS_INTEGRATION_ENABLED=false
WORDPRESS_STAGING_URL=
WORDPRESS_AUTH_MODE=
WORDPRESS_AUTH_SECRET_REFERENCE=
WORDPRESS_TIMEOUT_MS=30000
WORDPRESS_MAX_RETRIES=1

# Slice 12 provider registry - names only, set real values in .env.local
# Ollama (local; disabled unless enabled; model must be installed locally)
AI_OLLAMA_ENABLED=false
AI_OLLAMA_BASE_URL=
AI_OLLAMA_MODEL=
# Google Gemini (OpenAI-compatible endpoint; free-tier label is quota-limited)
AI_GEMINI_ENABLED=false
AI_GEMINI_MODEL=
AI_GEMINI_API_KEY=
# OpenRouter (explicit model slug; openrouter/free is non-deterministic)
AI_OPENROUTER_ENABLED=false
AI_OPENROUTER_BASE_URL=
AI_OPENROUTER_API_KEY=
AI_OPENROUTER_MODEL=
AI_OPENROUTER_ALLOW_FREE_ROUTER=false

# WooCommerce capability gate for the optional Shop page (Slice 16)
WOOCOMMERCE_ENABLED=false
