# ── WordPress content source (SERVER-SIDE ONLY — never exposed to the browser) ──
# Base REST URL of the staging WordPress site, e.g. https://staging.example.co.ke/wp-json
# Leave unset in development to render from the local fixture instead.
WORDPRESS_API_URL=

# Target Home page on the staging site. HOME_PAGE_ID (numeric) takes
# precedence; otherwise WORDPRESS_PAGE_SLUG is used (default "home").
HOME_PAGE_ID=
WORDPRESS_PAGE_SLUG=home

# WordPress application password credentials — ONLY if the staging site is
# not publicly readable. Users → Profile → Application Passwords in WP admin.
# Server-side only; never commit; never expose to client JavaScript.
# NOTE: Next.js skips its data cache for requests carrying an Authorization
# header, so authenticated reads are always fresh (no-store).
# WORDPRESS_APP_USER=haipa-operator
# WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Cache & revalidation ─────────────────────────────────────────────────
# Cache/revalidation window for WordPress-fetched content, in seconds.
# Default: 3600. The protected endpoint POST /api/revalidate (header
# x-revalidate-secret) invalidates the cache immediately after a publish.
WORDPRESS_REVALIDATE_SECONDS=3600

# Secret protecting POST /api/revalidate. Server-side only; never commit.
# REVALIDATE_SECRET=change-me

# Set to "true" to allow the local fixture as a content fallback regardless
# of NODE_ENV (hosted preview deployments / diagnostics). Never enable for
# live customer sites.
PREVIEW_MODE=
