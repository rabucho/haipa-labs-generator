{
  "name": "haipa-labs-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "export": "vitest run tests/export.test.ts",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "operator:create": "node --env-file=.env.local scripts/create-operator.mjs",
    "operator:reset": "node --env-file=.env.local scripts/create-operator.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.436.0",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^16.3.3",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
